provenance recursa-spike=b410d2f123cd7510a8a40e9e5b971936a2fd8463 source=src/grammars/cskw.rs description=src/descriptions/cskw.rs
transform fixed-wrappers=positional-or-presence sql=flat-ll2 precedence=declared repetitions=typed-cardinality
recursa-semantic-projection-v1
grammar edition=Rust2024 anchor=cskw equivalence=AsciiInsensitive

[lexical]
equivalence AsciiInsensitive
selection LongestPrefixThenFixedThenAuthoredPatternPriority
kind content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None
kind fixed:,
kind fixed:AS
kind fixed:FROM
kind fixed:SELECT
base content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None pattern="[a-zA-Z_][a-zA-Z0-9_]*" targets=[Alias,ColumnName,TableName] priority=0
keyword AS recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword FROM recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword SELECT recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
target Alias base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
target ColumnName base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
target TableName base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
rule Fixed(",") kind=fixed:, priority=Fixed
rule Regex("[a-zA-Z_][a-zA-Z0-9_]*") kind=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None priority=Pattern { authored: None }
non-token Regex("[ \\t\\n\\r]+") outcome=NonEmitting

[source-token-definitions]
fixed SELECT spelling="SELECT" canonical="SELECT" class=Keyword
fixed FROM spelling="FROM" canonical="FROM" class=Keyword
fixed AS spelling="AS" canonical="AS" class=Keyword
fixed COMMA spelling="," canonical="," class=Punctuation
lexical-base Word pattern="[a-zA-Z_][a-zA-Z0-9_]*" priority=None
content TableName pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText
content ColumnName pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText
content Alias pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText

[types]
type Alias = token(atom=Alias, text=any)
type ColumnName = token(atom=ColumnName, text=any)
type TableName = token(atom=TableName, text=any)
type fixed:, = token(atom=fixed:,, text=any)
type fixed:AS = token(atom=fixed:AS, text=any)
type fixed:FROM = token(atom=fixed:FROM, text=any)
type fixed:SELECT = token(atom=fixed:SELECT, text=any)
type cskw::Stmt = enum(cskw::Stmt::Select => [cskw::Stmt::Select::element0:cskw::Stmt target=cskw::SelectStmt cardinality=one separator=-])
type cskw::SelectStmt = sequence(cskw::SelectStmt::element0:cskw::SelectStmt target=fixed:SELECT cardinality=one separator=-, cskw::SelectStmt::element1:cskw::SelectStmt target=cskw::Col cardinality=one-or-more separator=fixed:,, cskw::SelectStmt::element2:cskw::SelectStmt target=fixed:FROM cardinality=one separator=-, cskw::SelectStmt::element3:cskw::SelectStmt target=TableName cardinality=one separator=-)
type cskw::Col = sequence(cskw::Col::element0:cskw::Col target=ColumnName cardinality=one separator=-, cskw::Col::element1:cskw::Col target=cskw::AsAlias cardinality=optional separator=-)
type cskw::AsAlias = sequence(cskw::AsAlias::element0:cskw::AsAlias target=fixed:AS cardinality=one separator=-, cskw::AsAlias::element1:cskw::AsAlias target=Alias cardinality=one separator=-)

[lowering-correlations]
field cskw::Stmt::Select::field0 -> parse-site(cskw::Stmt::Select::element0)
field cskw::SelectStmt::cols -> parse-site(cskw::SelectStmt::element1)
field cskw::SelectStmt::table -> parse-site(cskw::SelectStmt::element3)
field cskw::Col::name -> parse-site(cskw::Col::element0)
field cskw::Col::as_alias -> parse-site(cskw::Col::element1)
field cskw::AsAlias::alias -> parse-site(cskw::AsAlias::element1)

[analysis]
facts Alias first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] nullable=false
facts ColumnName first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] nullable=false
facts TableName first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] nullable=false
facts cskw::AsAlias first=[fixed:AS] nullable=false
facts cskw::Col first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] nullable=false
facts cskw::SelectStmt first=[fixed:SELECT] nullable=false
facts cskw::Stmt first=[fixed:SELECT] nullable=false
facts fixed:, first=[fixed:,] nullable=false
facts fixed:AS first=[fixed:AS] nullable=false
facts fixed:FROM first=[fixed:FROM] nullable=false
facts fixed:SELECT first=[fixed:SELECT] nullable=false
