provenance recursa-spike=b410d2f123cd7510a8a40e9e5b971936a2fd8463 source=src/grammars/cskw.rs description=src/descriptions/cskw.rs
transform fixed-wrappers=positional-or-presence sql=flat-ll2 pratt=typed-binding-powers repetitions=typed-cardinality
recursa-semantic-projection-v1
grammar edition=Rust2024 anchor=cskw max_lookahead=1 equivalence=AsciiInsensitive

[lexical]
equivalence AsciiInsensitive
selection LongestPrefixThenFixedThenAuthoredPatternPriority
kind content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None
kind fixed:,
kind fixed:AS
kind fixed:FROM
kind fixed:SELECT
base content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None pattern="[a-zA-Z_][a-zA-Z0-9_]*" targets=[Alias,ColumnName,TableName] priority=0
keyword AS recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword FROM recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword SELECT recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
target Alias base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
target ColumnName base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
target TableName base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
rule Fixed(",") kind=fixed:, priority=Fixed
rule Regex("[a-zA-Z_][a-zA-Z0-9_]*") kind=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None priority=Pattern { authored: None }
non-token Regex("[ \\t\\n\\r]+") outcome=NonEmitting

[source-token-definitions]
fixed SELECT spelling="SELECT" canonical="SELECT" class=Keyword
fixed FROM spelling="FROM" canonical="FROM" class=Keyword
fixed AS spelling="AS" canonical="AS" class=Keyword
fixed COMMA spelling="," canonical="," class=Punctuation
lexical-base Word pattern="[a-zA-Z_][a-zA-Z0-9_]*" priority=None
content TableName pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText
content ColumnName pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText
content Alias pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText

[types]
type Alias = token(atom=Alias, text=any)
type ColumnName = token(atom=ColumnName, text=any)
type TableName = token(atom=TableName, text=any)
type fixed:, = token(atom=fixed:,, text=any)
type fixed:AS = token(atom=fixed:AS, text=any)
type fixed:FROM = token(atom=fixed:FROM, text=any)
type fixed:SELECT = token(atom=fixed:SELECT, text=any)
type cskw::Stmt = enum(cskw::Stmt::Select => [cskw::Stmt::Select::element0:cskw::Stmt target=cskw::SelectStmt cardinality=one separator=- min_bp=0])
type cskw::SelectStmt = sequence(cskw::SelectStmt::element0:cskw::SelectStmt target=fixed:SELECT cardinality=one separator=- min_bp=0, cskw::SelectStmt::element1:cskw::SelectStmt target=cskw::Col cardinality=one-or-more separator=fixed:, min_bp=0, cskw::SelectStmt::element2:cskw::SelectStmt target=fixed:FROM cardinality=one separator=- min_bp=0, cskw::SelectStmt::element3:cskw::SelectStmt target=TableName cardinality=one separator=- min_bp=0)
type cskw::Col = sequence(cskw::Col::element0:cskw::Col target=ColumnName cardinality=one separator=- min_bp=0, cskw::Col::element1:cskw::Col target=cskw::AsAlias cardinality=optional separator=- min_bp=0)
type cskw::AsAlias = sequence(cskw::AsAlias::element0:cskw::AsAlias target=fixed:AS cardinality=one separator=- min_bp=0, cskw::AsAlias::element1:cskw::AsAlias target=Alias cardinality=one separator=- min_bp=0)

[lowering-correlations]
field cskw::Stmt::Select::field0 -> parse-site(cskw::Stmt::Select::element0)
field cskw::SelectStmt::cols -> parse-site(cskw::SelectStmt::element1)
field cskw::SelectStmt::table -> parse-site(cskw::SelectStmt::element3)
field cskw::Col::name -> parse-site(cskw::Col::element0)
field cskw::Col::as_alias -> parse-site(cskw::Col::element1)
field cskw::AsAlias::alias -> parse-site(cskw::AsAlias::element1)

[analysis]
facts Alias first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] nullable=false extenders=[-] follow=[fixed:,,fixed:FROM,EOF] first^k=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow
facts ColumnName first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] nullable=false extenders=[-] follow=[fixed:,,fixed:AS,fixed:FROM,EOF] first^k=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS -> caller-follow
facts TableName first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] nullable=false extenders=[-] follow=[EOF] first^k=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS -> caller-follow
facts cskw::AsAlias first=[fixed:AS] nullable=false extenders=[-] follow=[fixed:,,fixed:FROM,EOF] first^k=fixed:AS
facts cskw::Col first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] nullable=false extenders=[-] follow=[fixed:,,fixed:FROM,EOF] first^k=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS -> caller-follow | content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS
facts cskw::SelectStmt first=[fixed:SELECT] nullable=false extenders=[-] follow=[EOF] first^k=fixed:SELECT
facts cskw::Stmt first=[fixed:SELECT] nullable=false extenders=[-] follow=[EOF] first^k=fixed:SELECT
facts fixed:, first=[fixed:,] nullable=false extenders=[-] follow=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] first^k=fixed:, -> caller-follow
facts fixed:AS first=[fixed:AS] nullable=false extenders=[-] follow=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] first^k=fixed:AS -> caller-follow
facts fixed:FROM first=[fixed:FROM] nullable=false extenders=[-] follow=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] first^k=fixed:FROM -> caller-follow
facts fixed:SELECT first=[fixed:SELECT] nullable=false extenders=[-] follow=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] first^k=fixed:SELECT -> caller-follow

[decisions]
dispatch cskw::Stmt enum depth=1 caller-fallback=-
  cskw::Stmt::Select: fixed:SELECT
follow cskw::Stmt::Select::element0 caller
follow cskw::SelectStmt::element0 static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
follow cskw::SelectStmt::element1 static[fixed:FROM]
follow cskw::SelectStmt::element2 static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
follow cskw::SelectStmt::element3 caller
follow cskw::Col::element0 static+caller[fixed:AS]
follow cskw::Col::element1 caller
follow cskw::AsAlias::element0 static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
follow cskw::AsAlias::element1 caller
container cskw::Stmt::Select::element0 Direct element=[fixed:SELECT] separator=- separator-first=[] trailing=false stop=caller
  transition Start --ParseElement/static[fixed:SELECT]--> Done
container cskw::SelectStmt::element0 Direct element=[fixed:SELECT] separator=- separator-first=[] trailing=false stop=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
  transition Start --ParseElement/static[fixed:SELECT]--> Done
container cskw::SelectStmt::element1 OneOrMore element=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] separator=fixed:, separator-first=[fixed:,] trailing=false stop=static[fixed:FROM]
  transition Start --ParseElement/static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]--> AfterElement
  transition AfterElement --ParseSeparator/static[fixed:,]--> AfterSeparator
  transition AfterSeparator --ParseElement/static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]--> AfterElement
  transition AfterElement --Stop/static[fixed:FROM]--> Done
container cskw::SelectStmt::element2 Direct element=[fixed:FROM] separator=- separator-first=[] trailing=false stop=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
  transition Start --ParseElement/static[fixed:FROM]--> Done
container cskw::SelectStmt::element3 Direct element=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] separator=- separator-first=[] trailing=false stop=caller
  transition Start --ParseElement/static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]--> Done
container cskw::Col::element0 Direct element=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS] separator=- separator-first=[] trailing=false stop=static+caller[fixed:AS]
  transition Start --ParseElement/static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]--> Done
container cskw::Col::element1 Optional element=[fixed:AS] separator=- separator-first=[] trailing=false stop=caller
  transition Start --ParseElement/static[fixed:AS]--> Done
  transition Start --Stop/caller--> Done
  optional-viability depth=1 languages=2 trie=(terminals=[Skip@caller-follow] edges=[fixed:AS=>(terminals=[Consume] edges=[])])
container cskw::AsAlias::element0 Direct element=[fixed:AS] separator=- separator-first=[] trailing=false stop=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
  transition Start --ParseElement/static[fixed:AS]--> Done
container cskw::AsAlias::element1 Direct element=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] separator=- separator-first=[] trailing=false stop=caller
  transition Start --ParseElement/static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]--> Done

[failures]
failure cskw::Stmt - EnumDispatch expected=static[fixed:SELECT]
failure cskw::Stmt cskw::Stmt::Select::element0 RequiredSite expected=static[fixed:SELECT]
failure cskw::SelectStmt cskw::SelectStmt::element0 RequiredSite expected=static[fixed:SELECT]
failure cskw::SelectStmt cskw::SelectStmt::element1 ContainerMinimum expected=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
failure cskw::SelectStmt cskw::SelectStmt::element1 ContainerContinuation expected=continue[fixed:,] or stop[static[fixed:FROM]]
failure cskw::SelectStmt cskw::SelectStmt::element1 ContainerAfterSeparator expected=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
failure cskw::SelectStmt cskw::SelectStmt::element2 RequiredSite expected=static[fixed:FROM]
failure cskw::SelectStmt cskw::SelectStmt::element3 RequiredSite expected=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
failure cskw::Col cskw::Col::element0 RequiredSite expected=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None,fixed:AS]
failure cskw::AsAlias cskw::AsAlias::element0 RequiredSite expected=static[fixed:AS]
failure cskw::AsAlias cskw::AsAlias::element1 RequiredSite expected=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
