provenance recursa-spike=b410d2f123cd7510a8a40e9e5b971936a2fd8463 source=src/grammars/json.rs description=src/descriptions/json.rs
transform fixed-wrappers=positional-or-presence sql=flat-ll2 precedence=declared repetitions=typed-cardinality
recursa-semantic-projection-v1
grammar edition=Rust2024 anchor=json equivalence=Sensitive

[lexical]
equivalence Sensitive
selection LongestPrefixThenFixedThenAuthoredPatternPriority
kind content:"-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?":priority=None
kind content:"\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"":priority=None
kind fixed:,
kind fixed::
kind fixed:[
kind fixed:]
kind fixed:false
kind fixed:null
kind fixed:true
kind fixed:{
kind fixed:}
base content:"\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"":priority=None pattern="\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"" targets=[String] priority=0
base content:"-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?":priority=None pattern="-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?" targets=[Number] priority=0
keyword false recognition=standalone
keyword null recognition=standalone
keyword true recognition=standalone
target Number base=content:"-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?":priority=None accepts=[content:"-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?":priority=None]
target String base=content:"\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"":priority=None accepts=[content:"\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"":priority=None]
rule Fixed(",") kind=fixed:, priority=Fixed
rule Fixed(":") kind=fixed:: priority=Fixed
rule Fixed("[") kind=fixed:[ priority=Fixed
rule Fixed("]") kind=fixed:] priority=Fixed
rule Fixed("false") kind=fixed:false priority=Fixed
rule Fixed("null") kind=fixed:null priority=Fixed
rule Fixed("true") kind=fixed:true priority=Fixed
rule Fixed("{") kind=fixed:{ priority=Fixed
rule Fixed("}") kind=fixed:} priority=Fixed
rule Regex("\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"") kind=content:"\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"":priority=None priority=Pattern { authored: None }
rule Regex("-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?") kind=content:"-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?":priority=None priority=Pattern { authored: None }
non-token Regex("[ \\t\\n\\r]+") outcome=NonEmitting

[source-token-definitions]
fixed TRUE spelling="true" canonical="true" class=Keyword
fixed FALSE spelling="false" canonical="false" class=Keyword
fixed NULL spelling="null" canonical="null" class=Keyword
fixed LBRACE spelling="{" canonical="{" class=Punctuation
fixed RBRACE spelling="}" canonical="}" class=Punctuation
fixed LBRACKET spelling="[" canonical="[" class=Punctuation
fixed RBRACKET spelling="]" canonical="]" class=Punctuation
fixed COMMA spelling="," canonical="," class=Punctuation
fixed COLON spelling=":" canonical=":" class=Punctuation
content String pattern="\"([^\"\\\\\\x00-\\x1F]|\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4}))*\"" text=BorrowedOrOwnedMatchedText
content Number pattern="-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?" text=BorrowedOrOwnedMatchedText

[types]
type Number = token(atom=Number, text=any)
type String = token(atom=String, text=any)
type fixed:, = token(atom=fixed:,, text=any)
type fixed:: = token(atom=fixed::, text=any)
type fixed:[ = token(atom=fixed:[, text=any)
type fixed:] = token(atom=fixed:], text=any)
type fixed:false = token(atom=fixed:false, text=any)
type fixed:null = token(atom=fixed:null, text=any)
type fixed:true = token(atom=fixed:true, text=any)
type fixed:{ = token(atom=fixed:{, text=any)
type fixed:} = token(atom=fixed:}, text=any)
type json::Value = enum(json::Value::Object => [json::Value::Object::element0:json::Value target=json::Object cardinality=one separator=-]; json::Value::Array => [json::Value::Array::element0:json::Value target=json::Array cardinality=one separator=-]; json::Value::String => [json::Value::String::element0:json::Value target=String cardinality=one separator=-]; json::Value::Number => [json::Value::Number::element0:json::Value target=Number cardinality=one separator=-]; json::Value::Bool => [json::Value::Bool::element0:json::Value target=json::Bool cardinality=one separator=-]; json::Value::Null => [json::Value::Null::element0:json::Value target=fixed:null cardinality=one separator=-])
type json::Object = sequence(json::Object::element0:json::Object target=fixed:{ cardinality=one separator=-, json::Object::element1:json::Object target=json::Member cardinality=zero-or-more separator=fixed:,, json::Object::element2:json::Object target=fixed:} cardinality=one separator=-)
type json::Member = sequence(json::Member::element0:json::Member target=String cardinality=one separator=-, json::Member::element1:json::Member target=fixed:: cardinality=one separator=-, json::Member::element2:json::Member target=json::Value cardinality=one separator=-)
type json::Array = sequence(json::Array::element0:json::Array target=fixed:[ cardinality=one separator=-, json::Array::element1:json::Array target=json::Value cardinality=zero-or-more separator=fixed:,, json::Array::element2:json::Array target=fixed:] cardinality=one separator=-)
type json::Bool = enum(json::Bool::True => [json::Bool::True::element0:json::Bool target=fixed:true cardinality=one separator=-]; json::Bool::False => [json::Bool::False::element0:json::Bool target=fixed:false cardinality=one separator=-])

[lowering-correlations]
field json::Value::Object::field0 -> parse-site(json::Value::Object::element0)
field json::Value::Array::field0 -> parse-site(json::Value::Array::element0)
field json::Value::String::field0 -> parse-site(json::Value::String::element0)
field json::Value::Number::field0 -> parse-site(json::Value::Number::element0)
field json::Value::Bool::field0 -> parse-site(json::Value::Bool::element0)
field json::Object::members -> parse-site(json::Object::element1)
field json::Member::key -> parse-site(json::Member::element0)
field json::Member::value -> parse-site(json::Member::element2)
field json::Array::values -> parse-site(json::Array::element1)

