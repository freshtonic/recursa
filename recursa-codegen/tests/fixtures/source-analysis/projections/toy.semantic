provenance recursa-spike=b410d2f123cd7510a8a40e9e5b971936a2fd8463 source=src/grammars/toy.rs description=src/descriptions/toy.rs
transform fixed-wrappers=positional-or-presence sql=flat-ll2 pratt=typed-binding-powers repetitions=typed-cardinality
recursa-semantic-projection-v1
grammar edition=Rust2024 anchor=toy max_lookahead=1 equivalence=Sensitive

[lexical]
equivalence Sensitive
selection LongestPrefixThenFixedThenAuthoredPatternPriority
kind content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None
kind fixed:(
kind fixed:)
kind fixed:,
kind fixed:;
base content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None pattern="[a-zA-Z_][a-zA-Z0-9_]*" targets=[Ident] priority=0
target Ident base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
rule Fixed("(") kind=fixed:( priority=Fixed
rule Fixed(")") kind=fixed:) priority=Fixed
rule Fixed(",") kind=fixed:, priority=Fixed
rule Fixed(";") kind=fixed:; priority=Fixed
rule Regex("[a-zA-Z_][a-zA-Z0-9_]*") kind=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None priority=Pattern { authored: None }
non-token Regex("[ \\t\\n\\r]+") outcome=NonEmitting

[source-token-definitions]
fixed SEMI spelling=";" canonical=";" class=Punctuation
fixed COMMA spelling="," canonical="," class=Punctuation
fixed LPAREN spelling="(" canonical="(" class=Punctuation
fixed RPAREN spelling=")" canonical=")" class=Punctuation
content Ident pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText

[types]
type Ident = token(atom=Ident, text=any)
type fixed:( = token(atom=fixed:(, text=any)
type fixed:) = token(atom=fixed:), text=any)
type fixed:, = token(atom=fixed:,, text=any)
type fixed:; = token(atom=fixed:;, text=any)
type toy::SemicolonStmt = sequence(toy::SemicolonStmt::element0:toy::SemicolonStmt target=fixed:; cardinality=one separator=- min_bp=0)
type toy::IdentHolder = sequence(toy::IdentHolder::element0:toy::IdentHolder target=Ident cardinality=one separator=- min_bp=0)

[lowering-correlations]
field toy::IdentHolder::ident -> parse-site(toy::IdentHolder::element0)

[analysis]
facts Ident first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] nullable=false extenders=[-] follow=[EOF] first^k=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow
facts fixed:( first=[fixed:(] nullable=false extenders=[-] follow=[] first^k=fixed:( -> caller-follow
facts fixed:) first=[fixed:)] nullable=false extenders=[-] follow=[] first^k=fixed:) -> caller-follow
facts fixed:, first=[fixed:,] nullable=false extenders=[-] follow=[] first^k=fixed:, -> caller-follow
facts fixed:; first=[fixed:;] nullable=false extenders=[-] follow=[EOF] first^k=fixed:; -> caller-follow
facts toy::IdentHolder first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] nullable=false extenders=[-] follow=[EOF] first^k=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow
facts toy::SemicolonStmt first=[fixed:;] nullable=false extenders=[-] follow=[EOF] first^k=fixed:; -> caller-follow

[decisions]
follow toy::SemicolonStmt::element0 caller
follow toy::IdentHolder::element0 caller
container toy::SemicolonStmt::element0 Direct element=[fixed:;] separator=- separator-first=[] trailing=false stop=caller
  transition Start --ParseElement/static[fixed:;]--> Done
container toy::IdentHolder::element0 Direct element=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] separator=- separator-first=[] trailing=false stop=caller
  transition Start --ParseElement/static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]--> Done

[failures]
failure toy::SemicolonStmt toy::SemicolonStmt::element0 RequiredSite expected=static[fixed:;]
failure toy::IdentHolder toy::IdentHolder::element0 RequiredSite expected=static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
