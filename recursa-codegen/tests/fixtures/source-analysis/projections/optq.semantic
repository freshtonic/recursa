provenance recursa-spike=b410d2f123cd7510a8a40e9e5b971936a2fd8463 source=src/grammars/optq.rs description=src/descriptions/optq.rs
transform fixed-wrappers=positional-or-presence sql=flat-ll2 precedence=declared repetitions=typed-cardinality
recursa-semantic-projection-v1
grammar edition=Rust2024 anchor=optq equivalence=Sensitive

[lexical]
equivalence Sensitive
selection LongestPrefixThenFixedThenAuthoredPatternPriority
kind content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None
kind fixed:DEBUG
kind fixed:PRINT
kind fixed:READ
kind fixed:SET
base content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None pattern="[a-zA-Z_][a-zA-Z0-9_]*" targets=[Rest] priority=0
keyword DEBUG recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword PRINT recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword READ recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword SET recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
target Rest base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
rule Regex("[a-zA-Z_][a-zA-Z0-9_]*") kind=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None priority=Pattern { authored: None }
non-token Regex("[ \\t\\n\\r]+") outcome=NonEmitting

[source-token-definitions]
fixed DEBUG spelling="DEBUG" canonical="DEBUG" class=Keyword
fixed PRINT spelling="PRINT" canonical="PRINT" class=Keyword
fixed READ spelling="READ" canonical="READ" class=Keyword
fixed SET spelling="SET" canonical="SET" class=Keyword
content Rest pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText

[types]
type Rest = token(atom=Rest, text=any)
type fixed:DEBUG = token(atom=fixed:DEBUG, text=any)
type fixed:PRINT = token(atom=fixed:PRINT, text=any)
type fixed:READ = token(atom=fixed:READ, text=any)
type fixed:SET = token(atom=fixed:SET, text=any)
type optq::Debug = sequence(optq::Debug::element0:optq::Debug target=fixed:DEBUG cardinality=one separator=-)
type optq::Stmt = enum(optq::Stmt::Print => [optq::Stmt::Print::element0:optq::Stmt target=optq::PrintStmt cardinality=one separator=-]; optq::Stmt::Read => [optq::Stmt::Read::element0:optq::Stmt target=optq::ReadStmt cardinality=one separator=-]; optq::Stmt::Set => [optq::Stmt::Set::element0:optq::Stmt target=optq::SetStmt cardinality=one separator=-])
type optq::PrintStmt = sequence(optq::PrintStmt::element0:optq::PrintStmt target=optq::Debug cardinality=optional separator=-, optq::PrintStmt::element1:optq::PrintStmt target=fixed:PRINT cardinality=one separator=-, optq::PrintStmt::element2:optq::PrintStmt target=Rest cardinality=one separator=-)
type optq::ReadStmt = sequence(optq::ReadStmt::element0:optq::ReadStmt target=optq::Debug cardinality=optional separator=-, optq::ReadStmt::element1:optq::ReadStmt target=fixed:READ cardinality=one separator=-, optq::ReadStmt::element2:optq::ReadStmt target=Rest cardinality=one separator=-)
type optq::SetStmt = sequence(optq::SetStmt::element0:optq::SetStmt target=optq::Debug cardinality=optional separator=-, optq::SetStmt::element1:optq::SetStmt target=fixed:SET cardinality=one separator=-, optq::SetStmt::element2:optq::SetStmt target=Rest cardinality=one separator=-)

[lowering-correlations]
field optq::Stmt::Print::field0 -> parse-site(optq::Stmt::Print::element0)
field optq::Stmt::Read::field0 -> parse-site(optq::Stmt::Read::element0)
field optq::Stmt::Set::field0 -> parse-site(optq::Stmt::Set::element0)
field optq::PrintStmt::debug -> parse-site(optq::PrintStmt::element0)
field optq::PrintStmt::rest -> parse-site(optq::PrintStmt::element2)
field optq::ReadStmt::debug -> parse-site(optq::ReadStmt::element0)
field optq::ReadStmt::rest -> parse-site(optq::ReadStmt::element2)
field optq::SetStmt::debug -> parse-site(optq::SetStmt::element0)
field optq::SetStmt::rest -> parse-site(optq::SetStmt::element2)

[analysis]
facts Rest first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] nullable=false
facts fixed:DEBUG first=[fixed:DEBUG] nullable=false
facts fixed:PRINT first=[fixed:PRINT] nullable=false
facts fixed:READ first=[fixed:READ] nullable=false
facts fixed:SET first=[fixed:SET] nullable=false
facts optq::Debug first=[fixed:DEBUG] nullable=false
facts optq::PrintStmt first=[fixed:DEBUG,fixed:PRINT] nullable=false
facts optq::ReadStmt first=[fixed:DEBUG,fixed:READ] nullable=false
facts optq::SetStmt first=[fixed:DEBUG,fixed:SET] nullable=false
facts optq::Stmt first=[fixed:DEBUG,fixed:PRINT,fixed:READ,fixed:SET] nullable=false
