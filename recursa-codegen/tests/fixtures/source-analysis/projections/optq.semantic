provenance recursa-spike=b410d2f123cd7510a8a40e9e5b971936a2fd8463 source=src/grammars/optq.rs description=src/descriptions/optq.rs
transform fixed-wrappers=positional-or-presence sql=flat-ll2 pratt=typed-binding-powers repetitions=typed-cardinality
recursa-semantic-projection-v1
grammar edition=Rust2024 anchor=optq max_lookahead=2 equivalence=Sensitive

[lexical]
equivalence Sensitive
selection LongestPrefixThenFixedThenAuthoredPatternPriority
kind content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None
kind fixed:DEBUG
kind fixed:PRINT
kind fixed:READ
kind fixed:SET
base content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None pattern="[a-zA-Z_][a-zA-Z0-9_]*" targets=[Rest] priority=0
keyword DEBUG recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword PRINT recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword READ recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
keyword SET recognition=carriers[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
target Rest base=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None accepts=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
rule Regex("[a-zA-Z_][a-zA-Z0-9_]*") kind=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None priority=Pattern { authored: None }
non-token Regex("[ \\t\\n\\r]+") outcome=NonEmitting

[source-token-definitions]
fixed DEBUG spelling="DEBUG" canonical="DEBUG" class=Keyword
fixed PRINT spelling="PRINT" canonical="PRINT" class=Keyword
fixed READ spelling="READ" canonical="READ" class=Keyword
fixed SET spelling="SET" canonical="SET" class=Keyword
content Rest pattern="[a-zA-Z_][a-zA-Z0-9_]*" text=BorrowedOrOwnedMatchedText

[types]
type Rest = token(atom=Rest, text=any)
type fixed:DEBUG = token(atom=fixed:DEBUG, text=any)
type fixed:PRINT = token(atom=fixed:PRINT, text=any)
type fixed:READ = token(atom=fixed:READ, text=any)
type fixed:SET = token(atom=fixed:SET, text=any)
type optq::Debug = sequence(optq::Debug::element0:optq::Debug target=fixed:DEBUG cardinality=one separator=- min_bp=0)
type optq::Stmt = enum(optq::Stmt::Print => [optq::Stmt::Print::element0:optq::Stmt target=optq::PrintStmt cardinality=one separator=- min_bp=0]; optq::Stmt::Read => [optq::Stmt::Read::element0:optq::Stmt target=optq::ReadStmt cardinality=one separator=- min_bp=0]; optq::Stmt::Set => [optq::Stmt::Set::element0:optq::Stmt target=optq::SetStmt cardinality=one separator=- min_bp=0])
type optq::PrintStmt = sequence(optq::PrintStmt::element0:optq::PrintStmt target=optq::Debug cardinality=optional separator=- min_bp=0, optq::PrintStmt::element1:optq::PrintStmt target=fixed:PRINT cardinality=one separator=- min_bp=0, optq::PrintStmt::element2:optq::PrintStmt target=Rest cardinality=one separator=- min_bp=0)
type optq::ReadStmt = sequence(optq::ReadStmt::element0:optq::ReadStmt target=optq::Debug cardinality=optional separator=- min_bp=0, optq::ReadStmt::element1:optq::ReadStmt target=fixed:READ cardinality=one separator=- min_bp=0, optq::ReadStmt::element2:optq::ReadStmt target=Rest cardinality=one separator=- min_bp=0)
type optq::SetStmt = sequence(optq::SetStmt::element0:optq::SetStmt target=optq::Debug cardinality=optional separator=- min_bp=0, optq::SetStmt::element1:optq::SetStmt target=fixed:SET cardinality=one separator=- min_bp=0, optq::SetStmt::element2:optq::SetStmt target=Rest cardinality=one separator=- min_bp=0)

[lowering-correlations]
field optq::Stmt::Print::field0 -> parse-site(optq::Stmt::Print::element0)
field optq::Stmt::Read::field0 -> parse-site(optq::Stmt::Read::element0)
field optq::Stmt::Set::field0 -> parse-site(optq::Stmt::Set::element0)
field optq::PrintStmt::debug -> parse-site(optq::PrintStmt::element0)
field optq::PrintStmt::rest -> parse-site(optq::PrintStmt::element2)
field optq::ReadStmt::debug -> parse-site(optq::ReadStmt::element0)
field optq::ReadStmt::rest -> parse-site(optq::ReadStmt::element2)
field optq::SetStmt::debug -> parse-site(optq::SetStmt::element0)
field optq::SetStmt::rest -> parse-site(optq::SetStmt::element2)

[analysis]
facts Rest first=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] nullable=false extenders=[-] follow=[EOF] first^k=content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow
facts fixed:DEBUG first=[fixed:DEBUG] nullable=false extenders=[-] follow=[fixed:PRINT,fixed:READ,fixed:SET,EOF] first^k=fixed:DEBUG -> caller-follow
facts fixed:PRINT first=[fixed:PRINT] nullable=false extenders=[-] follow=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] first^k=fixed:PRINT -> caller-follow
facts fixed:READ first=[fixed:READ] nullable=false extenders=[-] follow=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] first^k=fixed:READ -> caller-follow
facts fixed:SET first=[fixed:SET] nullable=false extenders=[-] follow=[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None] first^k=fixed:SET -> caller-follow
facts optq::Debug first=[fixed:DEBUG] nullable=false extenders=[-] follow=[fixed:PRINT,fixed:READ,fixed:SET,EOF] first^k=fixed:DEBUG -> caller-follow
facts optq::PrintStmt first=[fixed:DEBUG,fixed:PRINT] nullable=false extenders=[-] follow=[EOF] first^k=fixed:DEBUG fixed:PRINT | fixed:PRINT content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow
facts optq::ReadStmt first=[fixed:DEBUG,fixed:READ] nullable=false extenders=[-] follow=[EOF] first^k=fixed:DEBUG fixed:READ | fixed:READ content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow
facts optq::SetStmt first=[fixed:DEBUG,fixed:SET] nullable=false extenders=[-] follow=[EOF] first^k=fixed:DEBUG fixed:SET | fixed:SET content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow
facts optq::Stmt first=[fixed:DEBUG,fixed:PRINT,fixed:READ,fixed:SET] nullable=false extenders=[-] follow=[EOF] first^k=fixed:DEBUG fixed:PRINT,fixed:READ,fixed:SET | fixed:PRINT,fixed:READ,fixed:SET content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None -> caller-follow

[decisions]
dispatch optq::Stmt enum depth=2 caller-fallback=-
  optq::Stmt::Print: fixed:DEBUG fixed:PRINT | fixed:PRINT content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None <caller-follow>
  optq::Stmt::Read: fixed:DEBUG fixed:READ | fixed:READ content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None <caller-follow>
  optq::Stmt::Set: fixed:DEBUG fixed:SET | fixed:SET content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None <caller-follow>
follow optq::Debug::element0 caller
follow optq::Stmt::Print::element0 caller
follow optq::Stmt::Read::element0 caller
follow optq::Stmt::Set::element0 caller
follow optq::PrintStmt::element0 static[fixed:PRINT]
follow optq::PrintStmt::element1 static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
follow optq::PrintStmt::element2 caller
follow optq::ReadStmt::element0 static[fixed:READ]
follow optq::ReadStmt::element1 static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
follow optq::ReadStmt::element2 caller
follow optq::SetStmt::element0 static[fixed:SET]
follow optq::SetStmt::element1 static[content:"[a-zA-Z_][a-zA-Z0-9_]*":priority=None]
follow optq::SetStmt::element2 caller
container optq::Debug::element0 Direct element=[fixed:DEBUG] separator=- separator-first=[] trailing=false stop=caller
  transition Start --ParseElement/static[fixed:DEBUG]--> Done
