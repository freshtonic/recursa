// The scaffolder writes this template to `src/grammar.rs` and replaces `{{AST}}` with the AST
// storage under test: nothing for ordinary nested storage, `arena_ast,` for an arena AST, or
// `flat,` for a Flat AST. One grammar therefore serves every storage, and all three must accept
// and reject the same sources, with the same note and the same span.
recursa::grammar! {
    module = crate::grammar,
    {{AST}}
    configurations(pg17, pg18 = feature("since-pg18")),
    derives(Pretty, Arbitrary),
    keyword_matching = ascii_insensitive,
}

recursa::tokens! {
    trivia {
        Whitespace => r"[ \t\n\r]+",
    }
    categories { UNRESERVED, RESERVED }
    keywords {
        UNIQUE => "unique" in RESERVED,
        CHECK => "check" in RESERVED,
        NOT => "not" in RESERVED,
        DEFERRABLE => "deferrable" in RESERVED,
        INITIALLY => "initially" in RESERVED,
        IMMEDIATE => "immediate" in RESERVED,
        DEFERRED => "deferred" in RESERVED,
        #[config(since = pg18)]
        ENFORCED => "enforced" in RESERVED,
        COLUMN => "column" in RESERVED,
        DEFAULT => "default" in RESERVED,
        NULL => "null" in RESERVED,
        #[config(since = pg18)]
        PATH => "path" in RESERVED,
    }
    admissions { Unreserved = UNRESERVED }
    punctuation {
        LPAREN => "(",
        RPAREN => ")",
    }
}

recursa::ast_node! {
    /// `UNIQUE (<name>) <attr>...`, whose attribute list may be empty.
    pub struct Unique {
        #[tok(UNIQUE, LPAREN, this, RPAREN)]
        pub column: ColumnName,
        pub attrs: zero_or_many!(ConstraintAttr),
    }
}

recursa::ast_node! {
    /// `CHECK <attr>... <name>`, whose attribute list holds at least one attribute.
    ///
    /// One rejection rule set therefore covers two repetition forms, because both lower to the
    /// same non-empty list of the same element type.
    pub struct Check {
        #[tok(CHECK)]
        pub attrs: one_or_many!(ConstraintAttr),
        pub column: ColumnName,
    }
}

recursa::ast_node! {
    /// One constraint attribute, in any order and any number, as `ConstraintAttributeSpec` is.
    ///
    /// The rules below are the `processCASbits` checks: the specific message comes first, so an
    /// item that completes both pairs reports it rather than the general one.
    #[reject(
        pair(NotDeferrable, InitiallyDeferred),
        code = "42601",
        message = "constraint declared INITIALLY DEFERRED must be DEFERRABLE",
        cite = "gram.y REL_17_11 6114, ConstraintAttributeSpec",
    )]
    #[reject(
        pair(NotDeferrable, Deferrable),
        pair(InitiallyImmediate, InitiallyDeferred),
        code = "42601",
        message = "conflicting constraint properties",
        hint = "Write each constraint property once.",
        cite = "gram.y REL_17_11 6121, ConstraintAttributeSpec",
    )]
    #[config_attr(
        since = pg18,
        reject(
            pair(NotEnforced, Enforced),
            code = "42601",
            message = "conflicting enforcement properties",
            cite = "gram.y REL_18_6, ConstraintAttributeSpec",
        )
    )]
    pub enum ConstraintAttr {
        #[tok(NOT, DEFERRABLE)]
        NotDeferrable,
        #[tok(DEFERRABLE)]
        Deferrable,
        #[tok(INITIALLY, IMMEDIATE)]
        InitiallyImmediate,
        #[tok(INITIALLY, DEFERRED)]
        InitiallyDeferred,
        #[config(since = pg18)]
        #[tok(ENFORCED)]
        Enforced,
        #[config(since = pg18)]
        #[tok(NOT, ENFORCED)]
        NotEnforced,
    }
}

recursa::ast_node! {
    /// A column name: a word or a quoted identifier. It shares the option name's pattern, as
    /// every identifier token of one grammar does, so the lexer has one decision to make.
    pub struct ColumnName {
        #[lex(pattern = r#""[^"]+"|[A-Za-z_][A-Za-z0-9_]*"#, admits(Unreserved))]
        pub text: Word,
    }
}

recursa::ast_node! {
    /// `COLUMN <name> <option>...`, whose option list is `xmltable_column_option_list`: options
    /// in any order, each one at most once.
    pub struct Column {
        #[tok(COLUMN)]
        pub name: ColumnName,
        pub options: one_or_many!(ColumnOption),
    }
}

recursa::ast_node! {
    /// One column option, as `xmltable_column_option_el` is.
    ///
    /// `IDENT b_expr` names an option by its folded text, and the `xmltable_column_el` action
    /// reads that text: `path` and `default` count as the keyword arms of the same name, and
    /// `is_not_null` counts as nullability. From the newer build `PATH` is a keyword with its own
    /// arm, and the name `__pg__is_not_null` is refused by the `IDENT b_expr` action itself.
    #[classify(
        Named.name,
        fold = crate::fold_name,
        text("path", Path),
        text("default", Default),
        text("is_not_null", NotNull),
    )]
    #[config_attr(
        since = pg18,
        reject(
            one_of(Named, "__pg__is_not_null"),
            code = "42601",
            message = "option name cannot be used in XMLTABLE",
            cite = "gram.y REL_17_11 14098, xmltable_column_option_el",
        )
    )]
    #[reject(
        once(Path),
        code = "42601",
        message = "only one PATH value per column is allowed",
        cite = "gram.y REL_17_11 14047, xmltable_column_el",
    )]
    #[reject(
        once(Default),
        code = "42601",
        message = "only one DEFAULT value is allowed",
        cite = "gram.y REL_17_11 14038, xmltable_column_el",
    )]
    #[reject(
        once(NotNull, Null),
        code = "42601",
        message = "conflicting or redundant NULL / NOT NULL declarations",
        cite = "gram.y REL_17_11 14056, xmltable_column_el",
    )]
    #[reject(
        not_in(Named, "path", "default", "is_not_null"),
        code = "42601",
        message = "unrecognized column option",
        cite = "gram.y REL_17_11 14065, xmltable_column_el",
    )]
    pub enum ColumnOption {
        #[config(since = pg18)]
        #[tok(PATH, this)]
        Path(Value),
        #[tok(DEFAULT, this)]
        Default(Value),
        #[tok(NOT, NULL)]
        NotNull,
        #[tok(NULL)]
        Null,
        Named(NamedOption),
    }
}

recursa::ast_node! {
    /// `IDENT b_expr`: an option named by an identifier.
    pub struct NamedOption {
        pub name: OptionName,
        pub value: Value,
    }
}

recursa::ast_node! {
    /// An option name: a word or a quoted identifier, as `IDENT` is.
    pub enum OptionName {
        Text(
            #[lex(pattern = r#""[^"]+"|[A-Za-z_][A-Za-z0-9_]*"#, admits(Unreserved))]
            OptionNameText,
        ),
    }
}

recursa::ast_node! {
    /// A quoted option value.
    pub struct Value {
        #[lex(pattern = r"'[^']*'")]
        pub text: ValueText,
    }
}
