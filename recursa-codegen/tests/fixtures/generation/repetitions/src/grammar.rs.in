recursa::grammar! {
    module = crate::grammar,
    derives(Pretty, Visit, VisitMut),
    keyword_matching = ascii_insensitive,
    spans = __RECURSA_SPANS_MODE__,
}

recursa::tokens! {
    ignore = r"[ \t\n\r]+",
    keywords {
        BOXED => "boxed",
        OPTIONAL => "optional",
        MANY => "many",
        MAYBE => "maybe",
        MARKS => "marks",
        CHOICE => "choice",
        EMPTY => "empty",
        STRICT => "strict",
        CAPTURE => "capture",
        NODE_OFF => "nodeoff",
        NODE_OPTIONAL => "nodeoptional",
        NODE_MANDATORY => "nodemandatory",
        FIELD_MANDATORY => "fieldmandatory",
        FIELD_OFF => "fieldoff",
        FIELD_OPTIONAL => "fieldoptional",
        VARIANT_OFF => "variantoff",
        VARIANT_MANDATORY => "variantmandatory",
        PARENT_OFF => "parentoff",
        PARENT_FIELD_OFF => "parentfieldoff",
        DESCENDANT => "descendant",
        DESCENDANTS => "descendants",
        MIXED => "mixed",
        MIX_OFF => "off",
        MIX_ON => "on",
        ATTACHED_OPTIONAL => "attachedoptional",
        ATTACHED_MANY => "attachedmany",
        ATTACHED_NONEMPTY => "attachednonempty",
        NODE_HINT => "nodehint",
        ENUM_HINT => "enumhint",
        CONSISTENT_HINT => "consistent",
        INCONSISTENT_HINT => "inconsistent",
        WORD_SEP => "or",
    }
    punctuation {
        COMMA => ",",
        DOT => ".",
        LPAREN => "(",
        RPAREN => ")",
        LBRACKET => "[",
        RBRACKET => "]",
        LBRACE => "{",
        RBRACE => "}",
        SEMICOLON => ";",
        TIGHT_OPEN => ":", spacing = tight,
        TIGHT_CLOSE => "?", spacing = tight,
        ATTACH_OPEN => "<",
        ATTACH_CLOSE => ">",
        AROUND_MARK => "@", spacing = around,
    }
}

recursa::ast_node! {

    pub struct Item {
        #[lex(pattern = r"[A-Za-z]+")]
        pub text: ItemText,
    }
}

recursa::ast_node! {

    #[tok(DOT)]
    pub struct Marker;
}

recursa::ast_node! {

    #[tok(DOT)]
    pub struct PunctuationItem;
}

recursa::ast_node! {

    pub struct AttachmentAround {
        pub before: Marker,
        #[tok(AROUND_MARK, this)]
        pub value: PunctuationItem,
    }
}

recursa::ast_node! {

    #[tok(CAPTURE, this)]
    pub struct InheritedCapture {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(NODE_OFF, this)]
    pub struct NodeOff {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(NODE_OPTIONAL, this)]
    pub struct NodeOptional {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(NODE_MANDATORY, this)]
    pub struct NodeMandatory {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(FIELD_MANDATORY, this)]
    pub struct FieldMandatory {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(FIELD_OFF, this)]
    pub struct FieldOff {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(FIELD_OPTIONAL, this)]
    pub struct FieldOptional {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    pub enum VariantCapture {
        #[tok(VARIANT_OFF, this)]
        Off { value: boxed!(Item) },
        #[tok(VARIANT_MANDATORY, this)]
        Mandatory { value: boxed!(Item) },
    }
}

recursa::ast_node! {

    #[tok(PARENT_OFF, this)]
    pub struct ParentOff {
        pub child: boxed!(NodeMandatory),
    }
}

recursa::ast_node! {

    #[tok(PARENT_FIELD_OFF, this)]
    pub struct ParentFieldOff {
        pub child: boxed!(NodeMandatory),
    }
}

recursa::ast_node! {

    #[tok(DESCENDANT, this)]
    pub struct DescendantMandatory {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(DESCENDANTS, this)]
    pub struct RepeatedDescendants {
        #[sep(COMMA)]
        pub values: zero_or_many!(boxed!(DescendantMandatory)),
    }
}

recursa::ast_node! {

    pub enum MixedCapture {
        #[tok(MIX_OFF)]
        Off,
        #[tok(MIX_ON)]
        On,
    }
}

recursa::ast_node! {

    #[tok(MIXED, this)]
    pub struct MixedMany {
        #[sep(COMMA)]
        pub values: zero_or_many!(MixedCapture),
    }
}

recursa::ast_node! {

    pub struct MixedProgram {
        #[sep(SEMICOLON)]
        #[pretty(separator = leading)]
        pub values: zero_or_many!(MixedCapture),
    }
}

recursa::ast_node! {

    pub struct WordSeparated {
        #[sep(WORD_SEP)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    pub struct OrdinaryChoices {
        pub values: zero_or_many!(MixedCapture),
    }
}

pub mod duplicate_enum {
    recursa::ast_node! {

        pub enum Duplicate {
            #[tok(MIX_OFF)]
            Off,
        }
    }
}

pub mod duplicate_struct {
    recursa::ast_node! {

        #[tok(MIX_ON)]
        pub struct Duplicate;
    }
}

recursa::ast_node! {

    pub struct DuplicateList {
        pub values: zero_or_many!(duplicate_struct::Duplicate),
    }
}

recursa::ast_node! {

    #[tok(MARKS, this)]
    pub struct LeadingPretty {
        #[sep(COMMA, trailing)]
        #[pretty(separator = leading, trailing_separator = always)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    #[tok(MARKS, this)]
    pub struct TrailingPretty {
        #[sep(COMMA, trailing)]
        #[pretty(separator = trailing, trailing_separator = never)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    pub struct AttachmentPretty {
        pub before: Marker,
        #[tok(ATTACH_OPEN, TIGHT_OPEN, BOXED, this, DOT, TIGHT_CLOSE, ATTACH_CLOSE)]
        #[pretty(group = inconsistent, indent, break_before = hard, break_after = hard)]
        pub value: boxed!(Item),
        pub after: Marker,
    }
}

recursa::ast_node! {

    pub struct HintAttachedOptional {
        pub before: Marker,
        #[tok(ATTACH_OPEN, TIGHT_OPEN, BOXED, this, DOT, TIGHT_CLOSE, ATTACH_CLOSE)]
        #[pretty(break_before = hard, break_after = hard)]
        pub value: Option<boxed!(Item)>,
        pub after: Marker,
    }
}

recursa::ast_node! {

    pub struct HintAttachedMany {
        pub before: Marker,
        #[tok(ATTACH_OPEN, TIGHT_OPEN, MANY, this_each, DOT, TIGHT_CLOSE, ATTACH_CLOSE)]
        #[pretty(break_before = hard, break_after = hard)]
        pub values: zero_or_many!(boxed!(Item)),
        pub after: Marker,
    }
}

recursa::ast_node! {

    pub struct AttachedMaybeMany {
        pub before: Marker,
        #[tok(ATTACH_OPEN, TIGHT_OPEN, MAYBE, this_each, DOT, TIGHT_CLOSE, ATTACH_CLOSE)]
        #[pretty(break_before = hard, break_after = hard)]
        pub values: Option<boxed!(one_or_many!(boxed!(Item)))>,
        pub after: Marker,
    }
}

recursa::ast_node! {

    #[tok(MARKS, this)]
    pub struct AttachedLeadingPretty {
        #[tok(LBRACKET, this_each, RBRACKET)]
        #[sep(COMMA, trailing)]
        #[pretty(separator = leading, trailing_separator = always)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    #[tok(MARKS, this)]
    pub struct AttachedTrailingPretty {
        #[tok(LBRACKET, this_each, RBRACKET)]
        #[sep(COMMA, trailing)]
        #[pretty(separator = trailing, trailing_separator = never)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    pub struct AttachedProgram {
        #[tok(LBRACKET, this_each, RBRACKET)]
        #[sep(SEMICOLON)]
        pub values: zero_or_many!(MixedCapture),
    }
}

recursa::ast_node! {

    #[tok(NODE_HINT, this)]
    #[pretty(group = inconsistent)]
    pub struct NodeGroupPretty {
        pub first: boxed!(Item),
        pub second: boxed!(Item),
    }
}

recursa::ast_node! {

    pub enum VariantGroupPretty {
        #[tok(ENUM_HINT, this)]
        #[pretty(group = inconsistent)]
        Value(boxed!(Item), boxed!(Item)),
    }
}

recursa::ast_node! {

    #[tok(CONSISTENT_HINT, this)]
    #[pretty(group = consistent, indent)]
    pub struct ConsistentIndentPretty {
        pub first: boxed!(Item),
        pub second: boxed!(Item),
        pub third: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(INCONSISTENT_HINT, this)]
    #[pretty(group = inconsistent, indent)]
    pub struct InconsistentIndentPretty {
        pub first: boxed!(Item),
        pub second: boxed!(Item),
        pub third: boxed!(Item),
    }
}

pub type PrettyAlias<T> = Vec<Box<T>>;

recursa::ast_node! {

    pub struct GenericAliasOutput {
        #[pretty(group = inconsistent)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    #[tok(BOXED, this)]
    pub struct Boxed {
        pub value: boxed!(Item),
    }
}

recursa::ast_node! {

    #[tok(OPTIONAL, this)]
    pub struct Optional {
        pub value: Option<boxed!(Item)>,
    }
}

recursa::ast_node! {

    #[tok(MANY, this)]
    pub struct Many {
        #[sep(COMMA, trailing)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    #[tok(MAYBE, this)]
    pub struct MaybeMany {
        #[sep(COMMA, trailing)]
        pub values: Option<boxed!(one_or_many!(boxed!(Item)))>,
    }
}

recursa::ast_node! {

    #[tok(MARKS, this)]
    pub struct NonEmptyMarkers {
        #[sep(COMMA)]
        pub values: boxed!(one_or_many!(boxed!(Marker))),
    }
}

recursa::ast_node! {

    pub enum Choice {
        #[tok(CHOICE, this)]
        Items {
            #[sep(COMMA)]
            items: one_or_many!(boxed!(Item)),
        },
        #[tok(EMPTY)]
        Empty,
    }
}

recursa::ast_node! {

    #[tok(STRICT, this)]
    pub struct Strict {
        #[sep(COMMA)]
        pub values: one_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    #[tok(ATTACHED_OPTIONAL, this)]
    pub struct AttachedOptional {
        #[tok(LPAREN, this, RPAREN)]
        pub value: Option<boxed!(Item)>,
    }
}

recursa::ast_node! {

    #[tok(ATTACHED_MANY, this)]
    pub struct AttachedMany {
        #[tok(LBRACKET, this_each, RBRACKET)]
        #[sep(COMMA, trailing)]
        pub values: zero_or_many!(boxed!(Item)),
    }
}

recursa::ast_node! {

    #[tok(ATTACHED_NONEMPTY, this)]
    pub struct AttachedNonEmpty {
        #[tok(LBRACE, this_each, RBRACE)]
        #[sep(COMMA, trailing)]
        pub values: Option<one_or_many!(boxed!(Item))>,
    }
}
