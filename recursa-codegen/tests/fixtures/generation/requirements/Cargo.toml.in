[package]
name = "recursa-generated-requirements"
version = "0.0.0"
edition = "2024"
rust-version = "1.88"
build = "build.rs"

[features]
default = []
since-v2 = []
since-v3 = ["since-v2"]
# States that the scaffolder wrote the `arena_ast` grammar. It reaches no gate; it only tells
# `main.rs` which wrapper the parse returns, and the scaffolder sets both together.
arena-ast = []

[dependencies]
recursa = { path = "{{RECURSA}}", features = ["spans"] }

[build-dependencies]
recursa-codegen = { path = "{{RECURSA_CODEGEN}}", features = ["spans"] }

[workspace]
